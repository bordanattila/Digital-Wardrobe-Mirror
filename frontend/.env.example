# Leave empty to use the Vite dev proxy (recommended).
# Requests like fetch("/api/weather/") go to the Vite server, which forwards to FastAPI.
VITE_API_BASE_URL=

# If you skip the proxy and call FastAPI directly, set e.g.:
# VITE_API_BASE_URL=http://127.0.0.1:8000
# (backend CORS must allow the Vite origin)
